# Pinned versions for the quickstart. Sourced by the hack/quickstart/ scripts.
#
# Policy: bump here only, all at once, and re-run docs/quickstart.md verbatim
# on fresh nodes before merging the bump. Every pin below was verified together
# on Ubuntu 24.04 and 26.04 nodes (4 vCPU / 8 GB); there is no automated
# freshness check.

# --- management cluster (node 1) ---------------------------------------------
K0SCTL_VERSION="v0.32.2"
K0S_VERSION="v1.33.8+k0s.1"            # KCM's pre-flight needs Kubernetes >= 1.32

# Default StorageClass for the hosted control plane's etcd PVC.
OPENEBS_VERSION="4.5.1"
OPENEBS_REPO_URL="https://openebs.github.io/openebs"

# k0rdent Cluster Manager. Only the k0smotron + projectsveltos providers are
# installed (setup-management.sh creates the Management object itself).
# Ceiling: KCM 1.11.0 bundles k0smotron v2, whose CRDs reject the bare `spec:`
# of RemoteCluster in exalsius-remote-cluster 0.1.5; needs a template release
# with `spec: {}` first. KCM 1.10.0 bundles k0smotron 1.10.6, which needs the
# Ubuntu 26.04 worker note in docs/quickstart.md (uutils stat).
KCM_VERSION="1.10.0"
KCM_CHART="oci://ghcr.io/k0rdent/kcm/charts/kcm"
KCM_NAMESPACE="kcm-system"

# exalsius-operator.
EXALSIUS_OPERATOR_VERSION="0.11.2"
EXALSIUS_OPERATOR_CHART="oci://ghcr.io/exalsius/charts/exalsius-operator"

# --- child cluster template ----------------------------------------------------
# The ClusterTemplate is named <chart>-<version with dots replaced by dashes>;
# examples/quickstart/colony.yaml references that name literally.
CLUSTER_TEMPLATES_REPO_URL="oci://ghcr.io/exalsius/cluster-templates/charts"
REMOTE_CLUSTER_TEMPLATE_CHART="exalsius-remote-cluster"
REMOTE_CLUSTER_TEMPLATE_VERSION="0.1.5"
REMOTE_CLUSTER_TEMPLATE_NAME="${REMOTE_CLUSTER_TEMPLATE_CHART}-${REMOTE_CLUSTER_TEMPLATE_VERSION//./-}"

# --- demo workspace catalog (public exalsius-workspace-hub) ---------------------
# The hub renders one immutable directory per chart version under
# manifests/<chart>/<version>/, so pinning a version path on `main` is stable.
WORKSPACE_HUB_REPO="exalsius/exalsius-workspace-hub"
WORKSPACE_HUB_REF="main"
JUPYTER_TEMPLATE_VERSION="0.3.0"
JUPYTER_TEMPLATE_NAME="jupyter-notebook-${JUPYTER_TEMPLATE_VERSION//./-}"

WORKSPACE_HUB_RAW="https://raw.githubusercontent.com/${WORKSPACE_HUB_REPO}/${WORKSPACE_HUB_REF}/manifests"
JUPYTER_SERVICETEMPLATE_URL="${WORKSPACE_HUB_RAW}/jupyter-notebook/${JUPYTER_TEMPLATE_VERSION}/servicetemplate.yaml"
JUPYTER_WORKSPACECLASS_URL="${WORKSPACE_HUB_RAW}/jupyter-notebook/${JUPYTER_TEMPLATE_VERSION}/workspaceclass.yaml"
