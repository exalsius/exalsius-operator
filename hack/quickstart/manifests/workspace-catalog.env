# Pinned sources for the quickstart's demo workspace catalog.
# Sourced by the quickstart setup script; bump the version here only.
#
# The hub renders one immutable directory per chart version under
# manifests/<chart>/<version>/, so pinning a version path on `main` is stable.
WORKSPACE_HUB_REPO="exalsius/exalsius-workspace-hub"
WORKSPACE_HUB_REF="main"
JUPYTER_TEMPLATE_VERSION="0.3.0"

WORKSPACE_HUB_RAW="https://raw.githubusercontent.com/${WORKSPACE_HUB_REPO}/${WORKSPACE_HUB_REF}/manifests"
JUPYTER_SERVICETEMPLATE_URL="${WORKSPACE_HUB_RAW}/jupyter-notebook/${JUPYTER_TEMPLATE_VERSION}/servicetemplate.yaml"
JUPYTER_WORKSPACECLASS_URL="${WORKSPACE_HUB_RAW}/jupyter-notebook/${JUPYTER_TEMPLATE_VERSION}/workspaceclass.yaml"
