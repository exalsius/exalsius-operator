          <mxGeometry height="24" width="240" x="1830" y="1038" as="geometry" />
        </mxCell>
        <mxCell id="n77" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D4E4;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;fontColor=#3A4A5B;" value="&lt;b&gt;&amp;#8230;&lt;/b&gt; &amp;#160;&lt;font color=&quot;#8A94A6&quot;&gt;&amp;#183; admin-defined range&lt;/font&gt;" vertex="1">
          <mxGeometry height="24" width="240" x="1830" y="1066" as="geometry" />
