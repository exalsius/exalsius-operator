        <mxCell id="n86" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5A6B7B;fillColor=#F3EFFA;strokeColor=#8A5FBF;fontColor=#4A3B66;" value="&lt;b style=&quot;font-size:11px&quot;&gt;&amp;lt;cd&amp;gt;-waypoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;istio-system &amp;#183; the child half of the pair&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="380" x="730" y="1352" as="geometry" />
        </mxCell>
        <mxCell id="n87" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5A6B7B;" value="&lt;b style=&quot;font-size:11px&quot;&gt;ztunnel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;ambient &amp;#183; captures workspace pods&lt;/font&gt;" vertex="1">
          <mxGeometry height="44" width="380" x="730" y="1414" as="geometry" />
        </mxCell>
        <mxCell id="n88" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;A &lt;b&gt;waypoint name is a routing scope&lt;/b&gt;: cross-cluster traffic for a global service resolves only to clusters whose matching service uses that same waypoint. One pair per child pins traffic to this child and stops the fan-out that made every other cluster a relay hop.&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="380" x="730" y="1476" as="geometry" />
        </mxCell>
        <mxCell id="n89" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E8A4E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=13;fontStyle=1;fontColor=#4E8A4E;" value="ws-&amp;lt;name&amp;gt; &amp;#8212; Workspace Namespace &amp;#183; Operator-Created" vertex="1">
          <mxGeometry height="330" width="600" x="1170" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="n90" parent="1" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;kubernetesLabel=1;fontSize=11;fontColor=#243B53;fillColor=#2875E2;prIcon=ns;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Namespace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;ws-&amp;lt;name&amp;gt;&lt;/font&gt;" vertex="1">
