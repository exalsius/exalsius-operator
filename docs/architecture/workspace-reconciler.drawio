          <mxGeometry height="26" width="210" x="1930" y="426" as="geometry" />
        </mxCell>
        <mxCell id="n51" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size:10px;color:#B85C00&quot;&gt;&lt;b&gt;Each release ships one versioned unit:&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="20" width="210" x="1930" y="464" as="geometry" />
        </mxCell>
        <mxCell id="n52" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#8FA6C4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#3A4A5B;" value="&lt;b style=&quot;font-size:10px&quot;&gt;Helm chart&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;immutable, to OCI&lt;/font&gt;" vertex="1">
          <mxGeometry height="34" width="210" x="1930" y="488" as="geometry" />
        </mxCell>
        <mxCell id="n53" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#8FA6C4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#3A4A5B;" value="&lt;b style=&quot;font-size:10px&quot;&gt;ServiceTemplate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;k0rdent CR&lt;/font&gt;" vertex="1">
          <mxGeometry height="34" width="210" x="1930" y="528" as="geometry" />
        </mxCell>
        <mxCell id="n54" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#8FA6C4;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#3A4A5B;" value="&lt;b style=&quot;font-size:10px&quot;&gt;WorkspaceClass&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;exalsius CR&lt;/font&gt;" vertex="1">
          <mxGeometry height="34" width="210" x="1930" y="568" as="geometry" />
        </mxCell>
        <mxCell id="n55" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 10px; color: rgb(90, 107, 123);&quot;&gt;The chart and both CRs version and ship together, and every name carries the version, e.g.&amp;nbsp;&amp;nbsp;&lt;i&gt;jupyter-notebook-1-0-1&lt;/i&gt;.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="210" x="1930" y="616" as="geometry" />
        </mxCell>
        <mxCell id="n56" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size:10px;color:#8A94A6&quot;&gt;A published version is never overwritten, so a rollback target always exists.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="210" x="1930" y="700" as="geometry" />
        </mxCell>
        <mxCell id="n57" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B07D2B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=13;fontStyle=1;fontColor=#B07D2B;" value="Sveltos" vertex="1">
          <mxGeometry height="145" width="420" x="250" y="1046" as="geometry" />
        </mxCell>
        <mxCell id="n58" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The operator never talks to Sveltos. It writes a ServiceSet on the management cluster; k0rdent turns that into a Profile &lt;b&gt;here&lt;/b&gt;, and Sveltos installs the chart on the child cluster below.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="270" y="1044" as="geometry" />
        </mxCell>
        <mxCell id="n59" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;dashed=1;dashPattern=6 4;fontColor=#4A5568;align=center;spacing=3;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Profile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;prerequisite&lt;/font&gt;" vertex="1">
          <mxGeometry height="44" width="190" x="270" y="1131" as="geometry" />
        </mxCell>
        <mxCell id="n60" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;dashed=1;dashPattern=6 4;fontColor=#4A5568;align=center;spacing=3;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Profile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;workspace&lt;/font&gt;" vertex="1">
          <mxGeometry height="44" width="190" x="470" y="1131" as="geometry" />
        </mxCell>
        <mxCell id="n61" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B07D2B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=13;fontStyle=1;fontColor=#B07D2B;dashed=1;dashPattern=8 4;" value="Tenant Ingress" vertex="1">
          <mxGeometry height="280" width="420" x="710" y="910" as="geometry" />
        </mxCell>
        <mxCell id="n62" parent="1" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;kubernetesLabel=1;fontSize=11;fontColor=#243B53;fillColor=#D79B00;prIcon=crd;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;wildcard cert &amp;#183; TLS&lt;/font&gt;" vertex="1">
          <mxGeometry height="42" width="42" x="730" y="948" as="geometry" />
        </mxCell>
        <mxCell id="n63" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5A6B7B;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Istio east-west gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;carries cross-network traffic&lt;/font&gt;" vertex="1">
          <mxGeometry height="42" width="310" x="800" y="944" as="geometry" />
        </mxCell>
        <mxCell id="n64" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5A6B7B;fillColor=#F3EFFA;strokeColor=#8A5FBF;fontColor=#4A3B66;" value="&lt;b style=&quot;font-size:11px&quot;&gt;&amp;lt;cd&amp;gt;-waypoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;istio-system &amp;#183; ClusterIP, internal&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="310" x="800" y="992" as="geometry" />
        </mxCell>
        <mxCell id="n65" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;All of it is tenant infrastructure the operator never mutates &amp;#8212; it only attaches routes. A missing Gateway is &lt;i&gt;InfraNotReadyError&lt;/i&gt;, admin-fixable.&lt;br&gt;&lt;br&gt;The Gateway&#39;s HTTPS listener hostname is the single source of truth for the tenant domain.&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="380" x="730" y="1056" as="geometry" />
        </mxCell>
        <mxCell id="n66" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B07D2B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=13;fontStyle=1;fontColor=#B07D2B;" value="ws-&amp;lt;name&amp;gt; &amp;#8212; Mirror Namespace &amp;#183; Operator-Created" vertex="1">
          <mxGeometry height="280" width="600" x="1170" y="910" as="geometry" />
        </mxCell>
        <mxCell id="n67" parent="1" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;kubernetesLabel=1;fontSize=11;fontColor=#243B53;fillColor=#D79B00;prIcon=crd;" value="&lt;b style=&quot;font-size:11px&quot;&gt;HTTPRoute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;hostname-matched&lt;/font&gt;" vertex="1">
          <mxGeometry height="42" width="42" x="1200" y="948" as="geometry" />
        </mxCell>
        <mxCell id="n68" parent="1" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;kubernetesLabel=1;fontSize=11;fontColor=#243B53;fillColor=#D79B00;prIcon=crd;" value="&lt;b style=&quot;font-size:11px&quot;&gt;TCPRoute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;one per tcp endpoint&lt;/font&gt;" vertex="1">
          <mxGeometry height="42" width="42" x="1330" y="948" as="geometry" />
        </mxCell>
        <mxCell id="n69" parent="1" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;kubernetesLabel=1;fontSize=11;fontColor=#243B53;fillColor=#2875E2;prIcon=svc;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Mirror Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;istio.io/global&lt;/font&gt;" vertex="1">
          <mxGeometry height="42" width="42" x="1460" y="948" as="geometry" />
        </mxCell>
        <mxCell id="n70" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 10px; color: rgb(90, 107, 123);&quot;&gt;The mirror Service is &lt;b&gt;selector-less, &lt;/b&gt;e.g.&amp;nbsp;no local endpoints. It exists only so istiod synthesizes cross-cluster endpoints for the child&#39;s Service of the same name.&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="560" x="1190" y="1032" as="geometry" />
        </mxCell>
        <mxCell id="n71" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D4E4;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;fontColor=#3A4A5B;" value="&lt;b&gt;istio.io/dataplane-mode: ambient&lt;/b&gt; &amp;#160;&lt;font color=&quot;#8A94A6&quot;&gt;&amp;#183; no waypoint labels on this side&lt;/font&gt;" vertex="1">
          <mxGeometry height="26" width="560" x="1190" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="n72" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The per-child waypoint scope is asserted on the child namespace alone, keeping the mirror free of a child-specific reference.&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="560" x="1190" y="1114" as="geometry" />
        </mxCell>
        <mxCell id="n73" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B07D2B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=13;fontStyle=1;fontColor=#B07D2B;dashed=1;dashPattern=8 4;" value="Port Pool &amp;#8212; Admin-Provisioned" vertex="1">
          <mxGeometry height="280" width="280" x="1810" y="910" as="geometry" />
        </mxCell>
        <mxCell id="n74" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Raw TCP carries no hostname, so ssh and tcp endpoints get a dedicated high port on the tenant domain.&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="240" x="1830" y="946" as="geometry" />
        </mxCell>
        <mxCell id="n75" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D4E4;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;fontColor=#3A4A5B;" value="&lt;b&gt;tcp-2300&lt;/b&gt; &amp;#160;&lt;font color=&quot;#8A94A6&quot;&gt;&amp;#183; allocated&lt;/font&gt;" vertex="1">
