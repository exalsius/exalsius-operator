          <mxGeometry height="50" width="380" x="270" y="1352" as="geometry" />
        </mxCell>
        <mxCell id="n81" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D4E4;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;fontColor=#3A4A5B;" value="&lt;b&gt;namespace&lt;/b&gt; &amp;#160;&lt;font color=&quot;#8A94A6&quot;&gt;&amp;#183; spec.namespace, else default&lt;/font&gt;" vertex="1">
          <mxGeometry height="26" width="380" x="270" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="n82" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D4E4;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;fontColor=#3A4A5B;" value="&lt;b&gt;shared&lt;/b&gt; &amp;#160;&lt;font color=&quot;#8A94A6&quot;&gt;&amp;#183; by every workspace here&lt;/font&gt;" vertex="1">
          <mxGeometry height="26" width="380" x="270" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="n83" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D4E4;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;fontColor=#3A4A5B;" value="&lt;b&gt;source&lt;/b&gt; &amp;#160;&lt;font color=&quot;#8A94A6&quot;&gt;&amp;#183; workspace, or the Colony&lt;/font&gt;" vertex="1">
