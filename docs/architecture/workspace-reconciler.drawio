        <mxCell id="n84" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;A ServiceSet watch fans one prerequisite&#39;s readiness out to every workspace waiting on it.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="270" y="1522" as="geometry" />
        </mxCell>
        <mxCell id="n85" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E8A4E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=13;fontStyle=1;fontColor=#4E8A4E;dashed=1;dashPattern=8 4;" value="Mesh Data Plane &amp;#8212; Admin-Provisioned" vertex="1">
