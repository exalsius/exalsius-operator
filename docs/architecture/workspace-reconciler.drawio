        <mxCell id="n78" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 10px; color: rgb(90, 107, 123);&quot;&gt;The set of attached TCPRoutes &lt;b&gt;is&lt;/b&gt; the allocation table, no state store, and deleting a route frees its port by construction.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="240" x="1830" y="1100" as="geometry" />
        </mxCell>
